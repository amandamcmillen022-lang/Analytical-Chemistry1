# this script creates a calibration curve of two buret passes
# If you want to use this script, don't forget to input your data!
# Your numbers should come right from the experiment :)
# This curve uses a cubic fitting model (CubicSpline)
# If you want your data plotted more simply, look at my other avg curve graphing file

import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline
from matplotlib.ticker import MultipleLocator, FormatStrFormatter

pass1_x = np.array([10.00, 20.00, 30.10, 40.00, 49.90])
pass1_y = np.array([-0.0293, 0.0390, -0.0180, 0.0187, 0.0085])

pass2_x = np.array([10.10, 20.00, 30.20, 40.20, 49.90])
pass2_y = np.array([-0.0042, 0.0714, -0.0050, 0.0329, -0.0277])


average_x = (pass1_x + pass2_x) / 2
average_y = (pass1_y + pass2_y) / 2


# SMOOTH curve through averaged points w Cubicspline!


curve = CubicSpline(average_x, average_y)

x_curve = np.linspace(
    average_x.min(),
    average_x.max(),
    400
)

y_curve = curve(x_curve)



plt.rcParams["font.family"] = "Times New Roman"
plt.rcParams["font.size"] = 12

fig, ax = plt.subplots(figsize=(7, 5))



ax.plot(
    x_curve,
    y_curve,
    color="black",
    linewidth=2
)



ax.plot(
    average_x,
    average_y,
    marker="o",
    markersize=5.5,
    markerfacecolor="white",
    markeredgecolor="black",
    markeredgewidth=1.2,
    linestyle="none"
)



ax.axhline(
    0,
    color="black",
    linewidth=0.8
)



ax.set_xlabel("Buret Reading (mL)")
ax.set_ylabel("Correction (mL)")
ax.set_title(
    "Buret Calibration Curve — Average of Two Passes",
    fontweight="bold"
)



ax.set_xlim(8, 52)
ax.set_ylim(-0.035, 0.080)

ax.xaxis.set_major_locator(MultipleLocator(5))
ax.yaxis.set_major_locator(MultipleLocator(0.005))

ax.yaxis.set_major_formatter(
    FormatStrFormatter("%.4f")
)



ax.tick_params(
    direction="in",
    length=5,
    width=1
)

for spine in ax.spines.values():
    spine.set_linewidth(1)

ax.grid(False)

plt.tight_layout()



plt.savefig(
    "buret_calibration_curve_average.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()
